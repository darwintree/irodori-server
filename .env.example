# --- Model & Inference ---
MODEL_CHECKPOINT=../outputs/sc29_v1_meanflow_clarity_fix/model_meanflow_s8000_clarity_fix.safetensors
SPEAKERS_DIR=../outputs/sc29_v1_speakers_s8000
CODEC_REPO=Aratako/Semantic-DACVAE-Japanese-32dim
# Optional: path to local Irodori-TTS clone when not installed in site-packages
IRODORI_REPO_PATH=../Irodori-TTS

MODEL_DEVICE=cpu
# auto: use bf16 on CPUs with amx_bf16 / avx512_bf16, fp32 otherwise; or force bf16 / fp32
MODEL_PRECISION=auto
CODEC_DEVICE=cpu
CODEC_PRECISION=fp32
CPU_THREADS=8
DEFAULT_NUM_STEPS=6
MAX_NUM_STEPS=16
ENABLE_WATERMARK=false
PRELOAD_ON_STARTUP=true
# Set to 1 in production once DACVAE / tokenizer are cached locally
HF_HUB_OFFLINE=1

# --- Reference Audio & Fallback ---
# Primary: download reference audio by reference_audio_id -> ref_wav
# Fallback: when reference_audio_id is empty (or download/encode fails if enabled below), use 49 KB ref_embed
REFERENCE_RESOURCE_SERVER=https://service.sc-viewer.top/convert/direct/sounds/voice/events
REFERENCE_DOWNLOAD_TIMEOUT_SECONDS=15
FALLBACK_TO_EMBED_ON_REF_ERROR=true
TMP_REFERENCE_DIR=./tmp_references

# --- Task Queue & Local Output ---
OUTPUT_DIR=./output
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_AGE_SECONDS=86400
MAX_PENDING_TASKS=20
MAX_TASK_HISTORY=1000
TASK_RATE_LIMIT=100/day

# --- Cloudflare R2 & Static Audio URL ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BASE_STATIC_URL=https://example.workers.dev/audio
